{
  "name": "balone-qa",
  "version": "1.0.0",
  "description": "Automação de testes para o site e catálogo do Brechó Balonê",
  "private": true,
  "scripts": {
    "test":              "playwright test",
    "test:smoke":        "playwright test --grep @smoke --project=chromium",
    "test:site":         "playwright test tests/site --project=chromium",
    "test:catalogo":     "playwright test tests/catalogo --project=chromium",
    "test:mobile":       "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:all-browsers": "playwright test tests/site tests/catalogo",
    "test:ui":           "playwright test --ui",
    "test:headed":       "playwright test --headed",
    "test:debug":        "playwright test --debug",
    "report:open":       "playwright show-report",
    "report:allure":     "allure serve allure-results",
    "codegen:site":      "playwright codegen https://www.brechobalone.com.br",
    "codegen:catalogo":  "playwright codegen https://catalogobalone.netlify.app",
    "typecheck":         "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3"
  }
}
